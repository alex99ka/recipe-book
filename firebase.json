{
  "hosting": {
    "site": "alex-recipe-book",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      ".last_build_id",
      "**/.DS_Store"
    ],
    "rewrites": [
      {
        "source": "/invite/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
